# Hide the GRUB boot-switch device from the running desktop.
# The block device stays visible to lsblk.
#
# Keep the UUID in sync with SWITCH_UUID in /etc/grub-boot-switch/config.
SUBSYSTEM=="block", ENV{ID_FS_UUID}=="67727562-626f-6f74-7377-697463680001", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_AUTO}="0"
