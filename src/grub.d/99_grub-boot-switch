#!/bin/sh
# /etc/grub.d/99_grub-boot-switch
#
# Hardware boot switch.
# The firmware presents a directory MARKER_DIR on the device containing exactly
# one file selNN (two digits, 00..99) for the current position. Only file
# existence is tested; no content from the device is read or executed.
#
# Host Config file contents:
#
#   sel<n>=<id>       -> auto-boot the entry <id> names -- 
#                        its menuentry id, or fallback to its title
#   sel<n>=           -> show the GRUB menu (infinite wait by default)
#   no sel<n>= line   -> grub.cfg default behaviour
#
# No switch device or no marker dir -> grub.cfg default behaviour
#

set -e

CONFIG=/etc/grub-boot-switch/config
BINDINGS=/etc/grub-boot-switch/bindings
[ -r "$CONFIG" ]   && . "$CONFIG"
[ -r "$BINDINGS" ] && . "$BINDINGS"
: "${SWITCH_UUID:=}"
: "${MENU_TIMEOUT:=-1}"
: "${MARKER_DIR:=grub-boot-switch}"

# Not configured -> emit nothing, leave GRUB untouched.
if [ -z "$SWITCH_UUID" ]; then
    echo "# grub-boot-switch: SWITCH_UUID unset in $CONFIG; disabled."
    exit 0
fi

# Collect "<number>:<variable>" pairs
pairs=
seen=
if [ -r "$BINDINGS" ]; then
    for name in $(sed -n 's/^[[:space:]]*\(sel[0-9][0-9]*\)=.*/\1/p' "$BINDINGS")
    do
        num=${name#sel}

        # a marker is selNN in the MARKER_DIR on the hardware device,
        # a binding is sel0 .. sel99 unpadded.
        case $num in
            0?*)
                echo "# grub-boot-switch: ${name}= is not a position name; ignored."
                continue
                ;;
        esac

        # Marker max 99 -- greater than 99 gets dropped
        if [ ${#num} -gt 2 ]; then
            echo "# grub-boot-switch: ${name}= is not reachable; ignored."
            continue
        fi
        case " $seen " in
            *" $num "*)
                # Keeps only the first one for duplicated lines
                echo "# grub-boot-switch: ${name}= repeats position ${num}; ignored."
                continue
                ;;
        esac
        seen="$seen $num"
        pairs="${pairs}${num}:${name}
"
    done
fi

# Handling "otherwise" case
if [ -z "$pairs" ]; then
    if [ -r "$BINDINGS" ]; then
        echo "# grub-boot-switch: no sel<n>= lines in $BINDINGS."
    else
        echo "# grub-boot-switch: $BINDINGS unreadable."
    fi
    exit 0
fi

# sort N in ascending order
pairs=$(printf '%s' "$pairs" | sort -t: -k1,1n)

show_menu="set timeout_style=menu; set timeout=${MENU_TIMEOUT}"

cat <<EOF2
# --- grub-boot-switch (generated) ---
insmod part_gpt
insmod part_msdos
insmod ext2
if search --no-floppy --fs-uuid --set=gbs_dev ${SWITCH_UUID} ; then
  set bootswitch=none
EOF2

# One test per bound position
for p in $pairs; do
    num=${p%%:*}
    echo "  if [ -f (\${gbs_dev})/${MARKER_DIR}/sel$(printf '%02d' "$num") ]; then set bootswitch=${num}; fi"
done

for p in $pairs; do
    num=${p%%:*}
    eval "id=\${${p#*:}:-}"
    if [ -n "$id" ]; then
        echo "  if [ \"\${bootswitch}\" = ${num} ]; then set default=\"${id}\"; set timeout=0; fi"
    else
        echo "  if [ \"\${bootswitch}\" = ${num} ]; then ${show_menu}; fi"
    fi
done

cat <<EOF2
fi
# --- end grub-boot-switch ---
EOF2

exit 0
